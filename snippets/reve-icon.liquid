{%- when 'instagram' -%}<svg class="rv-icon" style="stroke-width:1.2" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><rect x="2.6" y="2.6" width="14.8" height="14.8" rx="4.4"/><circle cx="10" cy="10" r="3.5"/><circle cx="14.6" cy="5.4" r="1" fill="currentColor" stroke="none"/></svg>
