{%- case icon -%}
{%- when 'menu' -%}<svg class="rv-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3 6h14M3 10h14M3 14h14" stroke-linecap="round"/></svg>
{%- when 'heart' -%}<svg class="rv-icon rv-icon--heart" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 16.5s-6-3.6-6-8.1A3.4 3.4 0 0110 6.3a3.4 3.4 0 016 2.1c0 4.5-6 8.1-6 8.1z" stroke-linejoin="round"/></svg>
{%- when 'account' -%}<svg class="rv-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><circle cx="10" cy="6.6" r="3.1"/><path d="M3.8 17c.7-3.4 3.1-5.2 6.2-5.2s5.5 1.8 6.2 5.2" stroke-linecap="round"/></svg>
{%- when 'search' -%}<svg class="rv-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><circle cx="8.8" cy="8.8" r="5.4"/><path d="M12.9 12.9L17 17" stroke-linecap="round"/></svg>
{%- when 'cart' -%}<svg class="rv-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M4.2 6.2h11.6L15 17H5L4.2 6.2z"/><path d="M7.4 6.2V5a2.6 2.6 0 015.2 0v1.2" stroke-linecap="round"/></svg>
