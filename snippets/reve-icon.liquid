{%- when 'next' -%}<svg class="rv-icon rv-icon--sm" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M5 2l5 5-5 5"/></svg>
{%- when 'pause' -%}<svg class="rv-icon-fill i-pause" width="12" height="14" viewBox="0 0 12 14" aria-hidden="true" focusable="false"><rect x="2" y="1" width="2" height="12"/><rect x="8" y="1" width="2" height="12"/></svg>
{%- when 'play' -%}<svg class="rv-icon-fill i-play" width="12" height="14" viewBox="0 0 12 14" aria-hidden="true" focusable="false"><path d="M2 1l9 6-9 6V1z"/></svg>
{%- when 'globe' -%}<svg class="rv-icon" style="width:18px;height:18px;stroke-width:1.1;flex:none" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="7.4"/><ellipse cx="10" cy="10" rx="3.2" ry="7.4"/><path d="M2.6 10h14.8M3.8 6.2h12.4M3.8 13.8h12.4"/></svg>
