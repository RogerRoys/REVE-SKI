{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
WISHLIST DRAWER
----------------------------------------------------------------------------------------------------------------------

Opened from the header heart (any element with aria-controls="wishlist-drawer"). Items are rendered by
assets/wishlist.js from the handles saved in the browser.
{%- endcomment -%}

<x-drawer id="wishlist-drawer" class="wishlist-drawer drawer" initial-focus="false">
  <p class="h4" slot="header">{{ settings.wishlist_title | default: 'Wishlist' }}</p>

  <div class="wishlist-drawer__body">
    <p id="wishlist-drawer-empty" class="wishlist-drawer__empty text-subdued">{{ settings.wishlist_empty_text | default: 'Your wishlist is empty.' }}</p>
    <ul id="wishlist-drawer-items" class="wishlist-drawer__items unstyled-list" role="list"></ul>
  </div>
</x-drawer>

<style>
  .wishlist-drawer__items {
    display: grid;
    gap: 1.5rem;
  }

  .wishlist-drawer__item {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  .wishlist-drawer__media img {
    display: block;
    width: 120px;
    height: 120px;
    object-fit: contain;
    background: #e6e4e2;
  }

  .wishlist-drawer__info {
    display: grid;
    gap: .4rem;
    padding-block-start: .25rem;
    font-family: var(--heading-font-family);
    font-size: var(--text-xs);
  }

  .wishlist-drawer__title {
    font-weight: 700;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: .02em;
  }

  .wishlist-drawer__price {
    color: rgb(var(--text-color) / .7);
  }

  .wishlist-drawer__actions {
    display: flex;
    gap: 1.25rem;
    margin-block-start: .5rem;
  }

  .wishlist-drawer__link,
  .wishlist-drawer__remove {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font: inherit;
    font-family: var(--text-font-family);
    font-size: var(--text-sm);
    color: rgb(var(--text-color));
    text-decoration: underline;
    text-underline-offset: .2em;
  }

  /* Wishlist button (product info block) */
  .reve-wishlist {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;
    width: 100%;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-family: var(--heading-font-family);
    font-size: var(--text-xs);
    color: rgb(var(--text-color));
  }

  .reve-wishlist svg {
    width: 1.1em;
    height: 1.1em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    transition: fill 0.15s ease;
  }

  .reve-wishlist.is-active svg {
    fill: currentColor;
  }

  .reve-wishlist .reve-wishlist__added,
  .reve-wishlist.is-active .reve-wishlist__add {
    display: none;
  }

  .reve-wishlist.is-active .reve-wishlist__added {
    display: inline;
  }

  /* Header heart */
  .header__wishlist {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .header__wishlist svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .header__wishlist-count {
    position: absolute;
    top: -8px;
    right: -10px;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    border-radius: 999px;
    background: rgb(var(--text-color));
    font-family: var(--heading-font-family);
    font-size: 10px;
    font-weight: 700;
    line-height: 17px;
    text-align: center;
    display: none;
  }

  /* Number stays readable on both header states: white on black, black on white */
  .header__wishlist-count span {
    color: #fff;
    mix-blend-mode: difference;
  }

  .header__wishlist-count.is-visible {
    display: block;
  }
</style>
