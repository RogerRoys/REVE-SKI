{%- comment -%}
Size chart content (client package "3a Classic modal"): CM / IN switch with two tables and a note.
Params: chart_page (CM page, optional), chart_page_in (IN page, optional), chart_note (text, optional)
When pages are set their content (a table each) replaces the built-in tables; with both pages the CM / IN switch toggles them.
The unit switch is handled in assets/wishlist.js ([data-rv-unit]); the chosen unit is remembered in the browser.
Edit the numbers in the two tables below.
{%- endcomment -%}
<div class="rvsc">
  {%- if chart_page != blank or chart_page_in != blank -%}
    {%- comment -%} Pages from the editor: CM page and (optional) IN page; the switch shows when both exist {%- endcomment -%}
    <div class="rvsc__bar">
      <span class="rvsc__sub">{{ product.title | default: 'Size guide' }}</span>
      {%- if chart_page != blank and chart_page_in != blank -%}
        <div class="rvsc__switch" role="group" aria-label="Units">
          <button type="button" data-rv-unit="cm" aria-pressed="true">CM</button>
          <button type="button" data-rv-unit="in" aria-pressed="false">IN</button>
        </div>
      {%- endif -%}
    </div>
    {%- if chart_page != blank -%}<div class="rvsc__page" data-rv-table="cm">{{ chart_page.content }}</div>{%- endif -%}
    {%- if chart_page_in != blank -%}<div class="rvsc__page" data-rv-table="in" {% if chart_page != blank %}hidden{% endif %}>{{ chart_page_in.content }}</div>{%- endif -%}
    {%- if chart_note != blank -%}<p class="rvsc__note">{{ chart_note | escape }}</p>{%- endif -%}
  {%- else -%}
    <div class="rvsc__bar">
      <span class="rvsc__sub">{{ product.title | default: 'Size guide' }}</span>
      <div class="rvsc__switch" role="group" aria-label="Units">
        <button type="button" data-rv-unit="cm" aria-pressed="true">CM</button>
        <button type="button" data-rv-unit="in" aria-pressed="false">IN</button>
      </div>
    </div>

    <table class="rvsc__table" data-rv-table="cm">
      <thead><tr><th>SIZE</th><th>A<br>CHEST</th><th>B<br>WAIST</th><th>C<br>HIP</th><th>D<br>INSEAM</th></tr></thead>
      <tbody>
        <tr><td>XS</td><td>76-81</td><td>61-66</td><td>81-86</td><td>78</td></tr>
        <tr><td>S</td><td>81-86</td><td>66-71</td><td>86-91</td><td>79</td></tr>
        <tr><td>M</td><td>86-91</td><td>71-76</td><td>91-96</td><td>80</td></tr>
        <tr><td>L</td><td>91-96</td><td>76-81</td><td>96-101</td><td>81</td></tr>
        <tr><td>XL</td><td>96-101</td><td>81-86</td><td>101-106</td><td>81</td></tr>
      </tbody>
    </table>

    <table class="rvsc__table" data-rv-table="in" hidden>
      <thead><tr><th>SIZE</th><th>A<br>CHEST</th><th>B<br>WAIST</th><th>C<br>HIP</th><th>D<br>INSEAM</th></tr></thead>
      <tbody>
        <tr><td>XS</td><td>30-32</td><td>24-26</td><td>32-34</td><td>31</td></tr>
        <tr><td>S</td><td>32-34</td><td>26-28</td><td>34-36</td><td>31</td></tr>
        <tr><td>M</td><td>34-36</td><td>28-30</td><td>36-38</td><td>31.5</td></tr>
        <tr><td>L</td><td>36-38</td><td>30-32</td><td>38-40</td><td>32</td></tr>
        <tr><td>XL</td><td>38-40</td><td>32-34</td><td>40-42</td><td>32</td></tr>
      </tbody>
    </table>

    <p class="rvsc__note">Body measurements in <span data-rv-unit-name>centimetres</span>.{% if chart_note != blank %} {{ chart_note | escape }}{% endif %}</p>
  {%- endif -%}
</div>
