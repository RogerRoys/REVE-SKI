{%- liquid
  assign color_opt = nil
  for opt in product.options_with_values
    assign on = opt.name | downcase
    if on == 'color' or on == 'colour'
      assign color_opt = opt
      break
    endif
  endfor
  assign main_media = product.featured_media
  assign alt_media = product.media[1]
-%}
<div class="rv-card">
  <div class="rv-card__media">
    <a href="{{ product.url }}" tabindex="-1" aria-hidden="true">
      {%- if main_media -%}
        <img src="{{ main_media | image_url: width: 900 }}" srcset="{{ main_media | image_url: width: 450 }} 450w, {{ main_media | image_url: width: 700 }} 700w, {{ main_media | image_url: width: 900 }} 900w" sizes="(min-width: 990px) 25vw, (min-width: 561px) 50vw, 78vw" width="{{ main_media.preview_image.width }}" height="{{ main_media.preview_image.height }}" alt="{{ product.title | escape }}" loading="lazy">
        {%- if alt_media -%}
          <img class="rv-card__alt" src="{{ alt_media | image_url: width: 900 }}" srcset="{{ alt_media | image_url: width: 450 }} 450w, {{ alt_media | image_url: width: 900 }} 900w" sizes="(min-width: 990px) 25vw, 50vw" width="{{ alt_media.preview_image.width }}" height="{{ alt_media.preview_image.height }}" alt="" loading="lazy">
        {%- endif -%}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'rv-placeholder' }}
      {%- endif -%}
    </a>
    <button type="button" class="rv-wish" data-rv-wish="{{ product.handle }}" aria-pressed="false" aria-label="Add to wishlist">{% render 'reve-icon', icon: 'heart' %}</button>

    {%- comment -%} Theme quick add "+" (Prestige): single variant adds directly, otherwise opens the quick buy modal {%- endcomment -%}
    {%- if settings.show_quick_buy and product.available -%}
      {%- if product.variants.size == 1 and product.selling_plan_groups.size == 0 -%}
        {%- form 'product', product, is: 'product-form' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" class="product-card__quick-add-button rv-card__quick-add">
            <span class="sr-only">{{ 'product.general.add_to_cart_button' | t }}</span>
            {%- render 'icon' with 'plus' -%}
          </button>
        {%- endform -%}
      {%- else -%}
        {%- capture quick_buy_id -%}product-quick-buy-{{ section.id }}-{{ block.id }}-rv-{{ product.id }}{%- endcapture -%}
        <button type="button" aria-controls="{{ quick_buy_id }}" class="product-card__quick-add-button rv-card__quick-add">
          <span class="sr-only">{{ 'product.general.choose_options' | t }}</span>
          {%- render 'icon' with 'plus' -%}
        </button>
        <quick-buy-modal handle="{{ product.handle }}" class="quick-buy-modal modal" id="{{ quick_buy_id }}"></quick-buy-modal>
      {%- endif -%}
    {%- endif -%}
  </div>
  <a href="{{ product.url }}" class="rv-card__row">
    <span class="rv-card__name">{{ product.title | default: 'Product name' | escape }}</span>
    <span class="rv-card__price">{% if product.price_varies %}From {% endif %}{{ product.price | money }}</span>
  </a>
  {%- if color_opt -%}
    {%- comment -%} Colour swatches switch the card image to that colour's variant image (theme behaviour) {%- endcomment -%}
    <div class="rv-card__swatches" data-rv-card-swatches>
      {%- for value in color_opt.values -%}
        {%- liquid
          assign hex = ''
          if value.swatch.color
            assign hex = value.swatch.color
          else
            capture hex
              render 'reve-color-hex', name: value
            endcapture
          endif
          assign variant_for_value = nil
          for v in product.variants
            if v.options[color_opt.position | minus: 1] == value
              assign variant_for_value = v
              break
            endif
          endfor
          assign media_for_value = variant_for_value.featured_media
          assign is_current = false
          if product.selected_or_first_available_variant.options[color_opt.position | minus: 1] == value
            assign is_current = true
          endif
        -%}
        <button type="button" class="rv-card__swatch" title="{{ value | escape }}" aria-label="{{ value | escape }}" aria-pressed="{% if is_current %}true{% else %}false{% endif %}"
          {% if media_for_value %}data-img="{{ media_for_value | image_url: width: 900 }}" data-img-450="{{ media_for_value | image_url: width: 450 }}" data-img-700="{{ media_for_value | image_url: width: 700 }}"{% endif %}
          {% if variant_for_value %}data-url="{{ product.url }}?variant={{ variant_for_value.id }}"{% endif %}
          style="background-color:{{ hex | strip }};{% if value.swatch.image %}background-image:url({{ value.swatch.image | image_url: width: 32 }});{% endif %}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>