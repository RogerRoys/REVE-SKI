{%- comment -%} Fallback colour map for option values without a native Shopify swatch. Add your own "name:#hex" pairs. {%- endcomment -%}
{%- liquid
  assign key = name | downcase | strip
  assign map = 'black:#191919|white:#FFFFFF|alabaster:#F4F1E6|ivory:#EFE8DE|cream:#EFE8DE|off white:#F4F1E6|navy:#1E2A38|red:#9E2A2B|grey:#8A8A8A|gray:#8A8A8A|charcoal:#3A3A3A|brown:#6B4A32|tan:#B48A60|beige:#D9CBB5|camel:#B8895A' | split: '|'
  assign out = '#D9D6D2'
  for pair in map
    assign kv = pair | split: ':'
    if kv[0] == key
      assign out = kv[1]
      break
    endif
  endfor
  echo out
-%}