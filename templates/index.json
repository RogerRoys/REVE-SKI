/*
 * Reve Ski — editorial home page (option-01)
 */
{
  "sections": {
    "hero": {
      "type": "reve-hero",
      "settings": {
        "heading": "The Western Edit",
        "text": "<p>This season, we’re taking fringe to the mountains. Wrangler, Landry wears our Lexi Jacket and our Phoenix Fringe Ski pants in Jackson Hole, Wyoming.</p>",
        "button_label": "Shop Now",
        "focal": "50% 45%",
        "image_asset": "rv-hero-western.jpg",
        "button_link": "shopify://collections/all",
        "transparent_header": true
      }
    },
    "tiles": {
      "type": "reve-tiles",
      "settings": {
        "numbers": true
      },
      "blocks": {
        "t1": {
          "type": "tile",
          "settings": {
            "title": "New Arrivals",
            "cta": "Shop now",
            "focal": "50% 22%",
            "image_asset": "rv-tile-new-arrivals-1.jpg",
            "image_asset_2": "rv-tile-new-arrivals-2.jpg",
            "image_asset_3": "rv-tile-new-arrivals-3.jpg",
            "link": "shopify://collections/new-arrivals"
          }
        },
        "t2": {
          "type": "tile",
          "settings": {
            "title": "Phoenix Ski Pant",
            "cta": "Shop now",
            "focal": "50% 30%",
            "image_asset": "tile-phoenix-ski-pant.jpg",
            "link": "shopify://products/phoenix-ski-pants"
          }
        }
      },
      "block_order": [
        "t1",
        "t2"
      ]
    },
    "featured": {
      "type": "reve-featured-product",
      "settings": {
        "eyebrow": "Featured piece",
        "show_price": false,
        "product": "phoenix-ski-pants",
        "image_asset": "rv-featured-phoenix-packshot.jpg"
      }
    },
    "arrivals": {
      "type": "reve-product-carousel",
      "settings": {
        "heading": "New Arrivals",
        "source": "collection",
        "limit": 8,
        "show_count": true,
        "anchor": "arrivals",
        "collection": "new-arrivals"
      }
    },
    "about": {
      "type": "reve-banner",
      "settings": {
        "heading": "Designed in the city. Made for the mountains.",
        "button_label": "About us",
        "focal": "50% 30%",
        "anchor": "about",
        "image_asset": "rv-about-banner-mountain.jpg",
        "button_link": "shopify://pages/about-us"
      }
    },
    "services": {
      "type": "reve-services",
      "settings": {
        "numbers": true
      },
      "blocks": {
        "s1": {
          "type": "service",
          "settings": {
            "title": "Get Help Buying",
            "text": "If you have any questions about our gear, get in touch.",
            "link_label": "Chat with us"
          }
        },
        "s2": {
          "type": "service",
          "settings": {
            "title": "Free FedEx® Delivery",
            "text": "All prices include customs delivery and import taxes. Orders above 2000 HKD ship for free.",
            "link_label": "Learn more"
          }
        },
        "s3": {
          "type": "service",
          "settings": {
            "title": "Free & Easy Returns",
            "text": "Returns are accepted within 14 days of delivery. Returns are free across all Reve Ski products, with the exception of collaborations, special projects, and Reve Ski Archive.",
            "link_label": "Learn more"
          }
        }
      },
      "block_order": [
        "s1",
        "s2",
        "s3"
      ]
    },
    "newsletter": {
      "type": "reve-newsletter",
      "settings": {
        "heading": "New drops",
        "text": "Sign up for early access to exclusive launches.",
        "button_label": "Subscribe"
      }
    }
  },
  "order": [
    "hero",
    "tiles",
    "featured",
    "arrivals",
    "about",
    "services",
    "newsletter"
  ]
