"settings":{"allow_transparent_header":false,"show_next_section_button":false,"media_size":"auto","autoplay":true,"autoplay_pause_on_video":true,"cycle_speed":5,"background":"#000000","controls_color":"#ffffff"}},"44bbb5ce-c6a1-46b4-b2ad-6ed45a4baaf2":{"type":"rich-text","blocks":{"template--21093308989735__44bbb5ce-c6a1-46b4-b2ad-6ed45a4baaf2-subheading-1":{"type":"subheading","disabled":true,"settings":{"text":"Subheading"}},"template--21093308989735__44bbb5ce-c6a1-46b4-b2ad-6ed45a4baaf2-heading-1":{"type":"heading","disabled":true,"settings":{"text":"Heading","heading_tag":"h1"}},"template--21093308989735__44bbb5ce-c6a1-46b4-b2ad-6ed45a4baaf2-richtext-1":{"type":"richtext","settings":{"content":"<p><strong>Mission<\/strong><\/p><p>Reve Ski designs one-of-a-kind skiwear for women who embody many worlds in one. <\/p><p><strong>A note from our founder <\/strong><\/p><p>I wanted to create skiwear that felt like real life: dynamic, layered, and always in motion. Clothes for women who move between places and identities — city and nature, work and escape — without leaving part of themselves behind.<\/p><p>My inspiration comes from all the places I’ve lived — Shanghai, New York, Los Angeles, and Texas — and the fragments I’ve collected along the way: contrasts, feelings, moments. It’s about discovery in the in-between, creating pieces that are personal and unique.<\/p><p>Reve Ski is designed for the mountains, influenced by the city, and rooted in a cross-cultural perspective. Each piece is thoughtfully created in small batches, carrying the same essence of wonder and possibility as the women who wear them.<\/p><p><\/p><p><strong>Our Materials<\/strong><\/p><p>Reve Ski’s textiles are BlueSign® certified, with fabrics and trims responsibly sourced and traceable down. We work with trusted partners who uphold ethical working environments, producing in considered volumes that honor both craftsmanship and the planet.<\/p><p><\/p>"}}},"block_order":["template--21093308989735__44bbb5ce-c6a1-46b4-b2ad-6ed45a4baaf2-subheading-1","template--21093308989735__44bbb5ce-c6a1-46b4-b2ad-6ed45a4baaf2-heading-1","template--21093308989735__44bbb5ce-c6a1-46b4-b2ad-6ed45a4baaf2-richtext-1"],"settings":{"separate_section_with_border":false,"content_width":"xs","text_position":"center","remove_vertical_spacing":false}},"b88d02c6-949e-49d2-9dff-48ef30783607":{"type":"newsletter","disabled":true,"custom_css":["{background-color: #fafafa; padding: 5px;}",".h2 {font-size: 20px;}"],"settings":{"separate_section_with_border":false,"image_size":"auto","subheading":"","title":"<strong>Empowering. Sophisticated. Adventurous.<\/strong>","content":"<p>That's REVE-SKI for you. Join us on this journey from city streets to snowy peaks, and embrace the REVE-SKI spirit.<\/p>","button_text":"Subscribe","text_color":"#1c1c1c","button_background":"","button_text_color":"","overlay_color":"#000000","overlay_opacity":0}}},"order":["main","189bee13-33dd-463f-9262-91bc2263a235","44bbb5ce-c6a1-46b4-b2ad-6ed45a4baaf2","b88d02c6-949e-49d2-9dff-48ef30783607"]}