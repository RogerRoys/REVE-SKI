{%- render 'reve-section-style' -%}
{%- assign s = section.settings -%}
<section class="rv rv-banner"{% if s.anchor != blank %} id="{{ s.anchor | handleize }}"{% endif %} style="--rv-banner-pos:{{ s.focal | default: '50% 30%' }}">
  <div class="rv-banner__media">
    {%- if s.image != blank -%}
      <img src="{{ s.image | image_url: width: 1920 }}" srcset="{{ s.image | image_url: width: 750 }} 750w, {{ s.image | image_url: width: 1200 }} 1200w, {{ s.image | image_url: width: 1920 }} 1920w, {{ s.image | image_url: width: 2400 }} 2400w" sizes="100vw" width="{{ s.image.width }}" height="{{ s.image.height }}" alt="{{ s.image.alt | escape }}" loading="lazy">
    {%- elsif s.image_asset != blank -%}
      <img src="{{ s.image_asset | asset_url }}" sizes="100vw" width="1200" height="1920" alt="{{ s.heading | escape }}" loading="lazy">
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'rv-placeholder' }}
    {%- endif -%}
  </div>
  <div class="rv-banner__shade"></div>
  <div class="rv-wrap rv-banner__content">
    {%- if s.heading != blank -%}<h2 class="rv-banner__title">{{ s.heading | escape }}</h2>{%- endif -%}
    {%- if s.button_label != blank -%}<a href="{{ s.button_link | default: '#' }}" class="rv-btn rv-btn--outline">{{ s.button_label | escape }}</a>{%- endif -%}
  </div>
</section>
{% schema %}
{
 "name": "Reve · Image banner",
 "tag": "div",
 "class": "rv-sec-banner",
 "settings": [
  {
   "type": "image_picker",
   "id": "image",
   "label": "Image"
  },
  {
   "type": "text",
   "id": "image_asset",
   "label": "Fallback image file (assets)",
   "info": "File name in the theme assets folder, used only when no image is picked above"
  },
  {
   "type": "text",
   "id": "focal",
   "label": "Image position",
   "default": "50% 30%"
  },
  {
   "type": "text",
   "id": "heading",
   "label": "Heading",
   "default": "Designed in the city. Made for the mountains."
  },
  {
   "type": "text",
   "id": "button_label",
   "label": "Button label",
   "default": "About us"
  },
  {
   "type": "url",
   "id": "button_link",
   "label": "Button link"
  },
  {
   "type": "text",
   "id": "anchor",
   "label": "Anchor id",
   "default": "about"
  },
  {
   "type": "header",
   "content": "Text & colors"
  },
  {
   "type": "paragraph",
   "content": "0 or empty = use the design default."
  },
  {
   "type": "range",
   "id": "rv_heading_size",
   "label": "Heading size (desktop)",
   "min": 0,
   "max": 200,
   "step": 2,
   "unit": "px",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_heading_size_mobile",
   "label": "Heading size (mobile)",
   "min": 0,
   "max": 120,
   "step": 2,
   "unit": "px",
   "default": 0
  },
  {
   "type": "select",
   "id": "rv_heading_uppercase",
   "label": "Heading case",
   "options": [
    {
     "value": "default",
     "label": "Design default"
    },
    {
     "value": "on",
     "label": "Uppercase"
    },
    {
     "value": "off",
     "label": "As typed"
    }
   ],
   "default": "default"
  },
  {
   "type": "range",
   "id": "rv_letter_spacing",
   "label": "Heading letter spacing",
   "min": -5,
   "max": 30,
   "step": 1,
   "unit": "%",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_text_size",
   "label": "Text size (desktop)",
   "min": 0,
   "max": 32,
   "step": 1,
   "unit": "px",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_text_size_mobile",
   "label": "Text size (mobile)",
   "min": 0,
   "max": 28,
   "step": 1,
   "unit": "px",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_small_size",
   "label": "Small text / labels size",
   "min": 0,
   "max": 20,
   "step": 1,
   "unit": "px",
   "default": 0
  },
  {
   "type": "color",
   "id": "rv_text_color",
   "label": "Text color"
  },
  {
   "type": "color",
   "id": "rv_bg_color",
   "label": "Background color"
  },
  {
   "type": "color",
   "id": "rv_accent_color",
   "label": "Accent color (links, lines, buttons)"
  }
 ],
 "presets": [
  {
   "name": "Reve · Image banner"
  }
 ]
}
{% endschema %}