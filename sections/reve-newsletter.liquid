{%- render 'reve-section-style' -%}
{%- assign s = section.settings -%}
{%- assign form_id = 'rv-news-' | append: section.id -%}
<section class="rv rv-news" id="newsletter">
  <div class="rv-wrap rv-news__inner">
    <div class="rv-news__intro">
      <h2 class="rv-h-xl">{{ s.heading | escape }}</h2>
      {%- if s.text != blank -%}<p>{{ s.text | escape }}</p>{%- endif -%}
    </div>
    {%- form 'customer', id: form_id, class: 'rv-news__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="rv-news__msg" role="status">{{ s.success | escape }}</p>
      {%- else -%}
        <div class="rv-news__row">
          <input type="email" name="contact[email]" required autocomplete="email" placeholder="Your email address" aria-label="Email address">
          <button type="submit" class="rv-btn">{{ s.button_label | escape }}</button>
        </div>
        {%- if form.errors -%}<p class="rv-news__msg" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
      {%- endif -%}
      {%- if s.legal != blank -%}<div class="rv-news__legal">{{ s.legal }}</div>{%- endif -%}
    {%- endform -%}
  </div>
</section>
{% schema %}
{
 "name": "Reve · Newsletter",
 "tag": "div",
 "class": "rv-sec-news",
 "settings": [
  {
   "type": "text",
   "id": "heading",
   "label": "Heading",
   "default": "New drops"
  },
  {
   "type": "text",
   "id": "text",
   "label": "Text",
   "default": "Sign up for early access to exclusive launches."
  },
  {
   "type": "text",
   "id": "button_label",
   "label": "Button label",
   "default": "Subscribe"
  },
  {
   "type": "richtext",
   "id": "legal",
   "label": "Legal text",
   "default": "<p>By registering, you accept the <a href=\"/policies/terms-of-service\">Terms of Use</a> and our <a href=\"/policies/privacy-policy\">Privacy Policy</a>.</p>"
  },
  {
   "type": "text",
   "id": "success",
   "label": "Success message",
   "default": "Thanks for subscribing."
  },
  {
   "type": "header",
   "content": "Text & colors"
  },
  {
   "type": "paragraph",
   "content": "0 or empty = use the design default."
  },
  {
   "type": "range",
   "id": "rv_heading_size",
   "label": "Heading size (desktop)",
   "min": 0,
   "max": 200,
   "step": 2,
   "unit": "px",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_heading_size_mobile",
   "label": "Heading size (mobile)",
   "min": 0,
   "max": 120,
   "step": 2,
   "unit": "px",
   "default": 0
  },
  {
   "type": "select",
   "id": "rv_heading_uppercase",
   "label": "Heading case",
   "options": [
    {
     "value": "default",
     "label": "Design default"
    },
    {
     "value": "on",
     "label": "Uppercase"
    },
    {
     "value": "off",
     "label": "As typed"
    }
   ],
   "default": "default"
  },
  {
   "type": "range",
   "id": "rv_letter_spacing",
   "label": "Heading letter spacing",
   "min": -5,
   "max": 30,
   "step": 1,
   "unit": "%",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_text_size",
   "label": "Text size (desktop)",
   "min": 0,
   "max": 32,
   "step": 1,
   "unit": "px",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_text_size_mobile",
   "label": "Text size (mobile)",
   "min": 0,
   "max": 28,
   "step": 1,
   "unit": "px",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_small_size",
   "label": "Small text / labels size",
   "min": 0,
   "max": 20,
   "step": 1,
   "unit": "px",
   "default": 0
  },
  {
   "type": "color",
   "id": "rv_text_color",
   "label": "Text color"
  },
  {
   "type": "color",
   "id": "rv_bg_color",
   "label": "Background color"
  },
  {
   "type": "color",
   "id": "rv_accent_color",
   "label": "Accent color (links, lines, buttons)"
  }
 ],
 "presets": [
  {
   "name": "Reve · Newsletter"
  }
 ]
}
{% endschema %}