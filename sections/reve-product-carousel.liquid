{%- render 'reve-section-style' -%}
{%- liquid
  assign s = section.settings
  assign use_recs = false
  assign need_fetch = false
  if s.source == 'recommendations' and product
    assign use_recs = true
    if recommendations.performed?
      assign items = recommendations.products
    else
      assign need_fetch = true
    endif
  else
    assign items = s.collection.products
  endif
  assign total = items.size
  if total > s.limit
    assign total = s.limit
  endif
-%}
<section class="rv rv-wrap rv-carousel"{% if s.anchor != blank %} id="{{ s.anchor | handleize }}"{% endif %} data-rv-carousel data-rv-recs-body{% if need_fetch %} data-rv-recs="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ s.limit }}&intent=related"{% endif %}>
  {%- if total > 0 -%}
    <div class="rv-carousel__head">
      <h2 class="rv-h-xl rv-carousel__title">{{ s.heading | escape }}{%- if s.show_count -%}<span class="rv-count">({% if total < 10 %}0{% endif %}{{ total }})</span>{%- endif -%}</h2>
      <div class="rv-arrows">
        <button type="button" class="rv-arrow" data-rv-dir="-1" aria-label="Previous">{% render 'reve-icon', icon: 'prev' %}</button>
        <button type="button" class="rv-arrow" data-rv-dir="1" aria-label="Next">{% render 'reve-icon', icon: 'next' %}</button>
      </div>
    </div>
    <div class="rv-track" data-rv-track>
      {%- for p in items limit: s.limit -%}{%- render 'reve-product-card', product: p -%}{%- endfor -%}
    </div>
  {%- elsif request.design_mode and use_recs == false -%}
    <div class="rv-carousel__head"><h2 class="rv-h-xl rv-carousel__title">{{ s.heading | escape }}</h2></div>
    <p class="rv-eyebrow rv-muted">Select a collection in the section settings.</p>
  {%- endif -%}
</section>
{% schema %}
{
 "name": "Reve · Product carousel",
 "tag": "div",
 "class": "rv-sec-carousel",
 "settings": [
  {
   "type": "text",
   "id": "heading",
   "label": "Heading",
   "default": "New Arrivals"
  },
  {
   "type": "select",
   "id": "source",
   "label": "Products from",
   "default": "collection",
   "options": [
    {
     "value": "collection",
     "label": "Collection"
    },
    {
     "value": "recommendations",
     "label": "Related products (product pages only)"
    }
   ]
  },
  {
   "type": "collection",
   "id": "collection",
   "label": "Collection"
  },
  {
   "type": "range",
   "id": "limit",
   "label": "Products to show",
   "min": 4,
   "max": 16,
   "step": 1,
   "default": 8
  },
  {
   "type": "checkbox",
   "id": "show_count",
   "label": "Show count (08)",
   "default": true
  },
  {
   "type": "text",
   "id": "anchor",
   "label": "Anchor id",
   "default": "arrivals",
   "info": "Used by links like /#arrivals"
  },
  {
   "type": "header",
   "content": "Text & colors"
  },
  {
   "type": "paragraph",
   "content": "0 or empty = use the design default."
  },
  {
   "type": "range",
   "id": "rv_heading_size",
   "label": "Heading size (desktop)",
   "min": 0,
   "max": 200,
   "step": 2,
   "unit": "px",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_heading_size_mobile",
   "label": "Heading size (mobile)",
   "min": 0,
   "max": 120,
   "step": 2,
   "unit": "px",
   "default": 0
  },
  {
   "type": "select",
   "id": "rv_heading_uppercase",
   "label": "Heading case",
   "options": [
    {
     "value": "default",
     "label": "Design default"
    },
    {
     "value": "on",
     "label": "Uppercase"
    },
    {
     "value": "off",
     "label": "As typed"
    }
   ],
   "default": "default"
  },
  {
   "type": "range",
   "id": "rv_letter_spacing",
   "label": "Heading letter spacing",
   "min": -5,
   "max": 30,
   "step": 1,
   "unit": "%",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_text_size",
   "label": "Text size (desktop)",
   "min": 0,
   "max": 32,
   "step": 1,
   "unit": "px",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_text_size_mobile",
   "label": "Text size (mobile)",
   "min": 0,
   "max": 28,
   "step": 1,
   "unit": "px",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_small_size",
   "label": "Small text / labels size",
   "min": 0,
   "max": 20,
   "step": 1,
   "unit": "px",
   "default": 0
  },
  {
   "type": "color",
   "id": "rv_text_color",
   "label": "Text color"
  },
  {
   "type": "color",
   "id": "rv_bg_color",
   "label": "Background color"
  },
  {
   "type": "color",
   "id": "rv_accent_color",
   "label": "Accent color (links, lines, buttons)"
  }
 ],
 "presets": [
  {
   "name": "Reve · Product carousel"
  }
 ]
}
{% endschema %}