{%- render 'reve-section-style' -%}
{%- if section.blocks.size > 0 -%}
<div class="rv rv-ann" data-speed="{{ section.settings.speed }}" role="region" aria-label="Announcements">
  <div class="rv-ann__dots">
    {%- if section.blocks.size > 1 -%}{%- for block in section.blocks -%}<button type="button" class="rv-ann__dot{% if forloop.first %} is-active{% endif %}" aria-label="Show message {{ forloop.index }}"></button>{%- endfor -%}{%- endif -%}
  </div>
  <div class="rv-ann__msgs">
    {%- for block in section.blocks -%}
      <div class="rv-ann__msg{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>{%- else -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
  <div class="rv-ann__end">
    {%- if section.blocks.size > 1 -%}<button type="button" class="rv-ann__toggle" aria-label="Pause">{% render 'reve-icon', icon: 'pause' %}{% render 'reve-icon', icon: 'play' %}</button>{%- endif -%}
  </div>
</div>
{%- endif -%}
{% schema %}
{
 "name": "Reve · Announcement bar",
 "tag": "div",
 "class": "rv-sec-ann",
 "enabled_on": {
  "groups": [
   "header"
  ]
 },
 "settings": [
  {
   "type": "range",
   "id": "speed",
   "label": "Seconds per message",
   "min": 3,
   "max": 12,
   "step": 1,
   "default": 5
  },
  {
   "type": "header",
   "content": "Text & colors"
  },
  {
   "type": "paragraph",
   "content": "0 or empty = use the design default."
  },
  {
   "type": "range",
   "id": "rv_heading_size",
   "label": "Heading size (desktop)",
   "min": 0,
   "max": 200,
   "step": 2,
   "unit": "px",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_heading_size_mobile",
   "label": "Heading size (mobile)",
   "min": 0,
   "max": 120,
   "step": 2,
   "unit": "px",
   "default": 0
  },
  {
   "type": "select",
   "id": "rv_heading_uppercase",
   "label": "Heading case",
   "options": [
    {
     "value": "default",
     "label": "Design default"
    },
    {
     "value": "on",
     "label": "Uppercase"
    },
    {
     "value": "off",
     "label": "As typed"
    }
   ],
   "default": "default"
  },
  {
   "type": "range",
   "id": "rv_letter_spacing",
   "label": "Heading letter spacing",
   "min": -5,
   "max": 30,
   "step": 1,
   "unit": "%",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_text_size",
   "label": "Text size (desktop)",
   "min": 0,
   "max": 32,
   "step": 1,
   "unit": "px",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_text_size_mobile",
   "label": "Text size (mobile)",
   "min": 0,
   "max": 28,
   "step": 1,
   "unit": "px",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_small_size",
   "label": "Small text / labels size",
   "min": 0,
   "max": 20,
   "step": 1,
   "unit": "px",
   "default": 0
  },
  {
   "type": "color",
   "id": "rv_text_color",
   "label": "Text color"
  },
  {
   "type": "color",
   "id": "rv_bg_color",
   "label": "Background color"
  },
  {
   "type": "color",
   "id": "rv_accent_color",
   "label": "Accent color (links, lines, buttons)"
  }
 ],
 "blocks": [
  {
   "type": "message",
   "name": "Message",
   "settings": [
    {
     "type": "text",
     "id": "text",
     "label": "Text",
     "default": "The new season starts here. Shop new arrivals"
    },
    {
     "type": "url",
     "id": "link",
     "label": "Link"
    }
   ]
  }
 ],
 "presets": [
  {
   "name": "Reve · Announcement bar",
   "blocks": [
    {
     "type": "message"
    }
   ]
  }
 ]
}
{% endschema %}