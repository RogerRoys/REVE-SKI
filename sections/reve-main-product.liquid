{%- render 'reve-section-style' -%}
{%- liquid
  assign s = section.settings
  assign current = product.selected_or_first_available_variant
  assign form_id = 'product-form-' | append: product.id | append: '-' | append: section.id
  assign chart_html = ''
  if s.show_chart
    capture chart_html
      render 'reve-size-chart', product: product, columns: s.chart_columns, rows_cm: s.chart_rows_cm, rows_in: s.chart_rows_in, chart_note: s.chart_note
    endcapture
  endif
-%}
<section class="rv rv-main-product" data-rv-product="{{ section.id }}" data-rv-main>
  <div class="rv-wrap rv-pdp">
    {%- comment -%}
      Editorial gallery with the theme's variant image sets: an image whose alt ends with "#Color_Black" only shows
      when Color = Black is selected (same rule as the Prestige gallery). Images without a "#" tag always show.
    {%- endcomment -%}
    {%- liquid
      assign current_variant = product.selected_or_first_available_variant
      assign option_names = product.options | join: '|'
    -%}
    <div class="rv-pdp__gallery" data-rv-gallery data-rv-option-names="{{ option_names | escape }}">
      {%- for media in product.media -%}
        {%- liquid
          assign ld = 'lazy'
          if forloop.index <= 2
            assign ld = 'eager'
          endif
          assign group_option = ''
          assign group_value = ''
          assign hidden = false
          if media.alt contains '#' and media.alt != product.title
            assign alt_parts = media.alt | split: '#'
            assign group_parts = alt_parts.last | split: '_'
            assign group_option = group_parts.first | strip
            assign group_value = group_parts.last | strip | downcase
            assign option = product.options_by_name[group_option]
            assign selected_value = option.selected_value | downcase
            if selected_value != group_value and media != current_variant.featured_media
              assign hidden = true
            endif
            assign alt = alt_parts.first | strip | default: product.title
          else
            assign alt = media.alt | default: product.title
          endif
        -%}
        <figure class="rv-pdp__media" data-rv-media-id="{{ media.id }}" {% if group_option != blank %}data-rv-group-option="{{ group_option | escape }}" data-rv-group-value="{{ group_value | escape }}"{% endif %} {% if hidden %}hidden{% endif %}>
          {%- case media.media_type -%}
            {%- when 'image' -%}
              <img src="{{ media | image_url: width: 1400 }}" srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 900 }} 900w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1400 }} 1400w" sizes="(min-width: 990px) 32vw, (min-width: 750px) 50vw, 86vw" width="{{ media.width }}" height="{{ media.height }}" alt="{{ alt | escape }}" loading="{{ ld }}">
            {%- when 'video' -%}
              {{ media | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false }}
            {%- when 'external_video' -%}
              {{ media | external_video_tag }}
            {%- else -%}
              {{ media | media_tag }}
          {%- endcase -%}
        </figure>
      {%- else -%}
        {%- for i in (1..4) -%}<figure class="rv-pdp__media">{{ 'product-apparel-1' | placeholder_svg_tag: 'rv-placeholder' }}</figure>{%- endfor -%}
      {%- endfor -%}
    </div>

    <div class="rv-pdp__info">
      <div class="rv-pdp__head">
        <h1 class="rv-pdp__title">{{ product.title | escape }}</h1>
        <p class="rv-pdp__price" data-rv-price>{{ current.price | money }}{% if current.compare_at_price > current.price %} <s>{{ current.compare_at_price | money }}</s>{% endif %}</p>
      </div>
      {%- if product.description != blank -%}<div class="rv-pdp__desc">{{ product.description }}</div>{%- endif -%}

      {%- form 'product', product, id: form_id, class: 'rv-pdp__form', novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ current.id }}">
        {%- render 'variant-picker', product: product, form_id: form_id, update_url: true, hide_sold_out_variants: false, selector_type: 'block', color_selector_type: 'color', size_chart_content: chart_html, size_chart_title: s.chart_title -%}
        <div class="rv-pdp__buy">
          <div class="rv-buy-row">
            <div class="rv-qty">
              <button type="button" data-rv-qty="-1" aria-label="Decrease quantity">−</button>
              <input type="number" name="quantity" value="1" min="1" max="99" inputmode="numeric" aria-label="Quantity">
              <button type="button" data-rv-qty="1" aria-label="Increase quantity">+</button>
            </div>
            {%- render 'reve-atc', current: current -%}
          </div>
          {%- if s.show_wishlist -%}
            <button type="button" class="rv-wish-link" data-rv-wish="{{ product.handle }}" data-rv-keep-label="1" aria-pressed="false">{% render 'reve-icon', icon: 'heart' %}Add to wishlist</button>
          {%- endif -%}
        </div>
      {%- endform -%}

      {%- comment -%} Content blocks in editor order: collapsible tabs (grouped) and "Pairs well with" grids {%- endcomment -%}
      {%- assign acc_open = false -%}
      {%- assign prev_type = '' -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'accordion' -%}
            {%- if block.settings.content != blank -%}
              {%- unless acc_open -%}<div class="rv-acc">{%- assign acc_open = true -%}{%- endunless -%}
              <details {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
                <summary>{{ block.settings.title | escape }}</summary>
                <div class="rv-acc__body">{{ block.settings.content }}</div>
              </details>
              {%- assign prev_type = 'accordion' -%}
            {%- endif -%}
          {%- when 'pairs' -%}
            {%- if acc_open -%}</div>{%- assign acc_open = false -%}{%- endif -%}
            {%- if block.settings.products != blank -%}
              <div class="rv-pairs{% if prev_type == 'accordion' %} rv-pairs--after-acc{% endif %}" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}<span class="rv-eyebrow rv-pairs__title">{{ block.settings.heading | escape }}</span>{%- endif -%}
                <div class="rv-pairs__grid">
                  {%- for p in block.settings.products limit: 4 -%}
                    <div class="rv-pair">
                      <a href="{{ p.url }}" class="rv-pair__media" tabindex="-1" aria-hidden="true">{%- if p.featured_media -%}<img src="{{ p.featured_media | image_url: width: 500 }}" width="{{ p.featured_media.preview_image.width }}" height="{{ p.featured_media.preview_image.height }}" alt="{{ p.title | escape }}" loading="lazy">{%- endif -%}</a>
                      <a href="{{ p.url }}" class="rv-pair__name">{{ p.title | escape }}</a>
                      <span class="rv-pair__price">{% if p.price_varies %}From {% endif %}{{ p.price | money }}</span>
                      {%- comment -%} Theme quick buy: one variant adds straight to the cart, otherwise the quick buy modal opens {%- endcomment -%}
                      {%- if p.available -%}
                        {%- if p.variants.size == 1 and p.selling_plan_groups.size == 0 -%}
                          {%- form 'product', p, is: 'product-form' -%}
                            <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
                            <button type="submit" class="rv-pair__cta">{{ 'product.general.add_to_cart_button' | t }}</button>
                          {%- endform -%}
                        {%- else -%}
                          {%- capture pair_qb_id -%}product-quick-buy-{{ section.id }}-{{ block.id }}-{{ p.id }}{%- endcapture -%}
                          <button type="button" class="rv-pair__cta" aria-controls="{{ pair_qb_id }}">{{ 'product.general.choose_options' | t }}</button>
                          <quick-buy-modal handle="{{ p.handle }}" class="quick-buy-modal modal" id="{{ pair_qb_id }}"></quick-buy-modal>
                        {%- endif -%}
                      {%- else -%}
                        <span class="rv-pair__cta rv-pair__cta--soldout">{{ 'product.general.sold_out_button' | t }}</span>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
              </div>
              {%- assign prev_type = 'pairs' -%}
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
      {%- if acc_open -%}</div>{%- endif -%}

      <div class="rv-perks">
        {%- for block in section.blocks -%}{%- if block.type == 'perk' -%}<span {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>{%- endif -%}{%- endfor -%}
      </div>
    </div>
  </div>

  <script type="application/json" data-rv-variants>{%- render 'reve-variants-json', product: product -%}</script>

  {%- if s.sticky -%}
    <div class="rv rv-sticky" data-rv-sticky="{{ section.id }}">
      {%- if product.featured_media -%}<img class="rv-sticky__img" src="{{ product.featured_media | image_url: width: 120 }}" width="52" height="64" alt="" loading="lazy">{%- endif -%}
      <div class="rv-sticky__info">
        <span class="rv-sticky__name">{{ product.title | escape }}</span>
        {%- unless product.has_only_default_variant -%}<span class="rv-sticky__variant" data-rv-sticky-variant>{{ current.title | escape }}</span>{%- endunless -%}
      </div>
      <button type="button" class="rv-btn" data-rv-atc>Add to cart</button>
    </div>
  {%- endif -%}

</section>
{%- comment -%} Theme quick buy: the "+" on product cards fetches this product page and reads #quick-buy-content {%- endcomment -%}
{%- render 'reve-quick-buy', product: product, size_chart_content: chart_html, size_chart_title: s.chart_title -%}

{% schema %}
{
 "name": "Reve · Product",
 "tag": "div",
 "class": "rv-sec-product",
 "enabled_on": {
  "templates": [
   "product"
  ]
 },
 "settings": [
  {
   "type": "paragraph",
   "content": "Variant image sets: add #Color_Black (option name _ value) at the end of an image's alt text and it only shows for that variant. Images without a tag show for every variant."
  },
  {
   "type": "checkbox",
   "id": "show_wishlist",
   "label": "Show wishlist button",
   "default": true
  },
  {
   "type": "checkbox",
   "id": "sticky",
   "label": "Sticky add to cart bar",
   "default": true
  },
  {
   "type": "header",
   "content": "Size chart"
  },
  {
   "type": "checkbox",
   "id": "show_chart",
   "label": "Show size chart link",
   "default": true
  },
  {
   "type": "text",
   "id": "chart_title",
   "label": "Popup title",
   "default": "Size chart"
  },
  {
   "type": "text",
   "id": "chart_columns",
   "label": "Columns",
   "default": "SIZE | A CHEST | B WAIST | C HIP | D INSEAM",
   "info": "Separate columns with |"
  },
  {
   "type": "textarea",
   "id": "chart_rows_cm",
   "label": "Rows — CM",
   "default": "XS | 76-81 | 61-66 | 81-86 | 78\nS | 81-86 | 66-71 | 86-91 | 79\nM | 86-91 | 71-76 | 91-96 | 80\nL | 91-96 | 76-81 | 96-101 | 81\nXL | 96-101 | 81-86 | 101-106 | 81",
   "info": "One size per line, cells separated with |"
  },
  {
   "type": "textarea",
   "id": "chart_rows_in",
   "label": "Rows — IN",
   "default": "XS | 30-32 | 24-26 | 32-34 | 31\nS | 32-34 | 26-28 | 34-36 | 31\nM | 34-36 | 28-30 | 36-38 | 31.5\nL | 36-38 | 30-32 | 38-40 | 32\nXL | 38-40 | 32-34 | 40-42 | 32",
   "info": "One size per line, cells separated with |"
  },
  {
   "type": "text",
   "id": "chart_note",
   "label": "Size chart note (shown after the unit line)",
   "default": "Between sizes? Size up for layering."
  },
  {
   "type": "header",
   "content": "Text & colors"
  },
  {
   "type": "paragraph",
   "content": "0 or empty = use the design default."
  },
  {
   "type": "range",
   "id": "rv_heading_size",
   "label": "Heading size (desktop)",
   "min": 0,
   "max": 200,
   "step": 2,
   "unit": "px",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_heading_size_mobile",
   "label": "Heading size (mobile)",
   "min": 0,
   "max": 120,
   "step": 2,
   "unit": "px",
   "default": 0
  },
  {
   "type": "select",
   "id": "rv_heading_uppercase",
   "label": "Heading case",
   "options": [
    {
     "value": "default",
     "label": "Design default"
    },
    {
     "value": "on",
     "label": "Uppercase"
    },
    {
     "value": "off",
     "label": "As typed"
    }
   ],
   "default": "default"
  },
  {
   "type": "range",
   "id": "rv_letter_spacing",
   "label": "Heading letter spacing",
   "min": -5,
   "max": 30,
   "step": 1,
   "unit": "%",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_line_height",
   "label": "Heading line height",
   "info": "0 = design default (90%)",
   "min": 0,
   "max": 140,
   "step": 5,
   "unit": "%",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_text_size",
   "label": "Text size (desktop)",
   "min": 0,
   "max": 32,
   "step": 1,
   "unit": "px",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_text_size_mobile",
   "label": "Text size (mobile)",
   "min": 0,
   "max": 28,
   "step": 1,
   "unit": "px",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_small_size",
   "label": "Small text / labels size",
   "min": 0,
   "max": 20,
   "step": 1,
   "unit": "px",
   "default": 0
  },
  {
   "type": "color",
   "id": "rv_text_color",
   "label": "Text color"
  },
  {
   "type": "color",
   "id": "rv_bg_color",
   "label": "Background color"
  },
  {
   "type": "color",
   "id": "rv_accent_color",
   "label": "Accent color (links, lines, buttons)"
  }
 ],
 "blocks": [
  {
   "type": "accordion",
   "name": "Collapsible tab",
   "settings": [
    {
     "type": "text",
     "id": "title",
     "label": "Title",
     "default": "Details"
    },
    {
     "type": "richtext",
     "id": "content",
     "label": "Content",
     "info": "Connect a product metafield with the dynamic source icon to make this product-specific."
    },
    {
     "type": "checkbox",
     "id": "open",
     "label": "Open by default",
     "default": false
    }
   ]
  },
  {
   "type": "pairs",
   "name": "Pairs well with",
   "settings": [
    {
     "type": "text",
     "id": "heading",
     "label": "Heading",
     "default": "Pairs well with"
    },
    {
     "type": "product_list",
     "id": "products",
     "label": "Products",
     "limit": 4
    }
   ]
  },
  {
   "type": "perk",
   "name": "Service line",
   "settings": [
    {
     "type": "text",
     "id": "text",
     "label": "Text",
     "default": "Free & Easy Returns within 14 days"
    }
   ]
  }
 ]
}
{% endschema %}