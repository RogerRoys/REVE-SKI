{%- comment -%}
  Heitz — Subscribe popup (1f Gold seal)
  Email signup → shows the first-order discount code in the popup.
  Add it to the Footer section group so it loads on every page.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign code = section.settings.code | default: 'HEITZ10' | upcase
  assign form_id = 'HzSubForm-' | append: sid
-%}

{%- if section.settings.enabled -%}
<div
  id="HzSub-{{ sid }}"
  class="hz-sub"
  data-delay="{{ section.settings.delay }}"
  data-days="{{ section.settings.days }}"
  data-mobile="{{ section.settings.show_mobile }}"
  data-design="{{ request.design_mode }}"
  aria-hidden="true"
>
  <div class="hz-sub__dim" data-hz-close></div>
  <div class="hz-sub__box" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="HzSubTitle-{{ sid }}">
    <button type="button" class="hz-sub__x" data-hz-close aria-label="Close">&times;</button>

    <div class="hz-sub__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(max-width: 749px) 100vw, 330px', alt: section.settings.image.alt | escape }}
      {%- endif -%}
    </div>

    <div class="hz-sub__body">
      <span class="hz-sub__seal" aria-hidden="true">
        <span class="hz-sub__seal-sm">{{ section.settings.seal_top | escape }}</span>
        <span class="hz-sub__seal-lg">{{ section.settings.seal_big | escape }}</span>
        <span class="hz-sub__seal-sm">{{ section.settings.seal_bottom | escape }}</span>
      </span>

      {%- form 'customer', id: form_id, class: 'hz-sub__form', novalidate: 'novalidate' -%}
        {%- assign done = false -%}
        {%- if form.posted_successfully? -%}{%- assign done = true -%}{%- endif -%}

        <div class="hz-sub__step" data-step="1" {% if done %}hidden{% endif %}>
          {%- if section.settings.eyebrow != blank -%}<span class="hz-sub__eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
          <h2 id="HzSubTitle-{{ sid }}" class="hz-sub__title">{{ section.settings.heading | escape }}</h2>
          <p class="hz-sub__text">{{ section.settings.text | escape }}</p>

          <input type="hidden" name="contact[tags]" value="newsletter,popup-first-order">
          <input type="hidden" name="contact[accepts_marketing]" value="true">
          <input
            class="hz-sub__input"
            type="email"
            name="contact[email]"
            inputmode="email"
            autocapitalize="off"
            spellcheck="false"
            autocomplete="email"
            placeholder="{{ section.settings.placeholder | escape }}"
            aria-label="{{ section.settings.placeholder | escape }}"
          >
          <button type="submit" class="hz-sub__btn" data-hz-submit>
            <span>{{ section.settings.button | escape }}</span>
          </button>
          {%- if form.errors -%}
            <p class="hz-sub__err" hidden>{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
          <p class="hz-sub__err" data-hz-err hidden role="alert"></p>
          <button type="button" class="hz-sub__later" data-hz-close>{{ section.settings.later | escape }}</button>
        </div>

        <div class="hz-sub__step" data-step="2" {% unless done %}hidden{% endunless %}>
          <h2 class="hz-sub__title">{{ section.settings.done_heading | escape }}</h2>
          <p class="hz-sub__text">{{ section.settings.done_text | escape }}</p>
          <div class="hz-sub__code">
            <span class="hz-sub__code-val" data-hz-code>{{ code }}</span>
            <button type="button" class="hz-sub__copy" data-hz-copy>Copy</button>
          </div>
          <a class="hz-sub__btn" href="{{ section.settings.done_link | default: routes.all_products_collection_url }}">
            <span>{{ section.settings.done_button | escape }}</span>
          </a>
          {%- if section.settings.done_note != blank -%}<p class="hz-sub__note">{{ section.settings.done_note | escape }}</p>{%- endif -%}
        </div>

        {%- if done -%}<span data-hz-posted hidden></span>{%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

<style>
  #HzSub-{{ sid }} { --hz-gold:#D9B97A; --hz-ink:#1A1B18; --hz-black:#000000; --hz-bronze:#9F6939; --hz-muted:#555555; --hz-line:#CFCFCF; --hz-cream:#FBF7F0;
    --hz-head: var(--font-heading--family, 'Cabin', sans-serif); --hz-body: var(--font-body--family, 'Jost', sans-serif);
    position: fixed !important; inset: 0 !important; width: auto !important; height: auto !important; margin: 0 !important; transform: none !important; contain: strict; z-index: 2147483000; display: flex; align-items: center; justify-content: center; padding: 16px;
    visibility: hidden; pointer-events: none; font-family: var(--hz-body); }
  #HzSub-{{ sid }}.is-open { visibility: visible; pointer-events: auto; }
  #HzSub-{{ sid }} .hz-sub__dim { position: absolute; inset: 0; background: rgba(0,0,0,.45); opacity: 0; transition: opacity .4s ease; }
  #HzSub-{{ sid }}.is-open .hz-sub__dim { opacity: 1; }
  #HzSub-{{ sid }} .hz-sub__box { position: relative; flex: none; width: 780px; max-width: 100%; max-height: calc(100% - 32px); overflow: auto; overscroll-behavior: contain; backface-visibility: hidden;
    background: #FFFFFF; color: #1F1F1F; display: grid; grid-template-columns: 330px minmax(0,1fr); box-shadow: 0 30px 80px rgba(0,0,0,.3);
    opacity: 0; transition: opacity .4s ease; outline: none; contain: layout paint; }
  #HzSub-{{ sid }}.is-open .hz-sub__box { opacity: 1; animation: hzSubPop .55s cubic-bezier(.2,.8,.2,1) both; }
  #HzSub-{{ sid }}.is-settled .hz-sub__box { animation: none; }
  @keyframes hzSubPop { from { transform: translateY(18px); } to { transform: none; } }
  #HzSub-{{ sid }} .hz-sub__box, #HzSub-{{ sid }} .hz-sub__box:hover, #HzSub-{{ sid }} .hz-sub__box:active, #HzSub-{{ sid }} .hz-sub__box:focus, #HzSub-{{ sid }} .hz-sub__box:focus-within { zoom: 1 !important; scale: none !important; }
  #HzSub-{{ sid }}.is-settled .hz-sub__box, #HzSub-{{ sid }}.is-settled .hz-sub__box:focus-within { transform: none !important; }
  #HzSub-{{ sid }} .hz-sub__input, #HzSub-{{ sid }} .hz-sub__input:focus, #HzSub-{{ sid }} .hz-sub__input:focus-visible { outline: none !important; outline-offset: 0 !important; box-shadow: none !important; border-width: 1px !important; }
  #HzSub-{{ sid }} .hz-sub__media { flex: none; }
  #HzSub-{{ sid }} .hz-sub__body { min-width: 0; }
  #HzSub-{{ sid }} .hz-sub__box *, #HzSub-{{ sid }} .hz-sub__box *:hover, #HzSub-{{ sid }} .hz-sub__box *:active, #HzSub-{{ sid }} .hz-sub__box *:focus { scale: none !important; }
  #HzSub-{{ sid }} .hz-sub__input, #HzSub-{{ sid }} .hz-sub__input:hover, #HzSub-{{ sid }} .hz-sub__input:active, #HzSub-{{ sid }} .hz-sub__input:focus { transform: none !important; font-size: 16px !important; height: 50px !important; min-height: 50px !important; padding: 0 16px !important; margin: 0 !important; }
  #HzSub-{{ sid }} .hz-sub__btn:active, #HzSub-{{ sid }} .hz-sub__copy:active, #HzSub-{{ sid }} .hz-sub__x:active, #HzSub-{{ sid }} .hz-sub__later:active { transform: none !important; }
  html.hz-sub-lock { overflow: hidden !important; }
  #HzSub-{{ sid }} button, #HzSub-{{ sid }} input, #HzSub-{{ sid }} a { all: unset; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  #HzSub-{{ sid }} button:focus-visible, #HzSub-{{ sid }} a:focus-visible { outline: 2px solid var(--hz-bronze); outline-offset: 2px; }
  #HzSub-{{ sid }} .hz-sub__x { position: absolute; top: 8px; right: 10px; z-index: 3; width: 44px; height: 44px; border: 0; background: none;
    font-size: 26px; font-weight: 300; line-height: 1; color: #1F1F1F; opacity: .6; cursor: pointer; transition: opacity .25s ease; }
  #HzSub-{{ sid }} .hz-sub__x:hover { opacity: 1; }
  #HzSub-{{ sid }} .hz-sub__media { position: relative; min-height: 100%; background: #E8DCC6; }
  #HzSub-{{ sid }} .hz-sub__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #HzSub-{{ sid }} .hz-sub__body { padding: 48px 44px 36px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 16px; }
  #HzSub-{{ sid }} .hz-sub__seal { width: 100px; height: 100px; border-radius: 50%; background: var(--hz-gold); color: var(--hz-ink); flex: none;
    display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1; font-family: var(--hz-head); font-weight: 600;
    box-shadow: 0 0 0 6px #FFFFFF, 0 0 0 7px var(--hz-gold); }
  #HzSub-{{ sid }} .hz-sub__seal-sm { font-size: 9px; letter-spacing: .16em; text-transform: uppercase; }
  #HzSub-{{ sid }} .hz-sub__seal-lg { font-size: 30px; margin: 6px 0; }
  #HzSub-{{ sid }} .hz-sub__form { width: 100%; display: grid; }
  #HzSub-{{ sid }} .hz-sub__step, #HzSub-{{ sid }} .hz-sub__step[hidden] { grid-area: 1 / 1; width: 100%; display: flex !important; flex-direction: column; align-items: center; justify-content: center; gap: 14px;
    opacity: 1; visibility: visible; transition: opacity .45s ease, visibility .45s; }
  #HzSub-{{ sid }} .hz-sub__step[hidden] { opacity: 0; visibility: hidden; pointer-events: none; }
  @keyframes hzSubIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  #HzSub-{{ sid }} .hz-sub__eyebrow { font-size: 12px; letter-spacing: .22em; text-transform: uppercase; color: var(--hz-bronze); }
  #HzSub-{{ sid }} .hz-sub__title { margin: 0; font-family: var(--hz-head); font-weight: 600; font-size: 32px; line-height: 1.15; color: var(--hz-black); }
  #HzSub-{{ sid }} .hz-sub__text { margin: 0; font-size: 15px; line-height: 1.6; color: var(--hz-muted); }
  #HzSub-{{ sid }} .hz-sub__input { width: 100%; min-height: 50px; border: 1px solid var(--hz-line); background: #FFFFFF; padding: 0 16px;
    font: inherit; font-size: 16px; color: #1F1F1F; text-align: center; outline: none; border-radius: 0; box-shadow: none; transform: none; -webkit-appearance: none; appearance: none; transition: border-color .3s ease; }
  #HzSub-{{ sid }} .hz-sub__input:focus, #HzSub-{{ sid }} .hz-sub__input:focus-visible { border-color: #1F1F1F; outline: none; box-shadow: none; transform: none; }
  #HzSub-{{ sid }} .hz-sub__input::placeholder { color: #85838F; opacity: 1; transition: opacity .35s ease, transform .35s ease; }
  #HzSub-{{ sid }} .hz-sub__input:focus::placeholder { opacity: 0; transform: translateY(-4px); }
  #HzSub-{{ sid }} .hz-sub__box, #HzSub-{{ sid }} .hz-sub__box * { touch-action: manipulation; }
  #HzSub-{{ sid }} .hz-sub__box:active, #HzSub-{{ sid }} .hz-sub__btn:active, #HzSub-{{ sid }} .hz-sub__copy:active, #HzSub-{{ sid }} .hz-sub__x:active { transform: none; }
  #HzSub-{{ sid }} .hz-sub__btn { width: 100%; min-height: 50px; border: 0; background: var(--hz-black); color: #FFFFFF; display: flex; align-items: center; justify-content: center;
    font: inherit; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; text-decoration: none; cursor: pointer; transition: background .3s ease; }
  #HzSub-{{ sid }} .hz-sub__btn:hover { background: var(--hz-bronze); color: #FFFFFF; }
  #HzSub-{{ sid }} .hz-sub__btn.is-busy { opacity: .6; pointer-events: none; }
  #HzSub-{{ sid }} .hz-sub__later { border: 0; background: none; padding: 4px; font: inherit; font-size: 13px; color: var(--hz-muted); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  #HzSub-{{ sid }} .hz-sub__inbox { display: flex; align-items: center; gap: 12px; padding: 16px 18px; border: 1px dashed var(--hz-bronze); background: #FFFFFF; font-size: 15px; line-height: 1.5; color: var(--hz-ink); text-align: left; }
  #HzSub-{{ sid }} .hz-sub__inbox svg { flex: none; color: var(--hz-bronze); }
  #HzSub-{{ sid }} .hz-sub__err { margin: 0; font-size: 13px; color: #B3261E; }
  #HzSub-{{ sid }} [data-hz-err] { min-height: 18px; line-height: 18px; transition: opacity .25s ease; }
  #HzSub-{{ sid }} [data-hz-err][hidden] { display: block; opacity: 0; }
  #HzSub-{{ sid }} .hz-sub__code { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 12px;
    border: 1px dashed var(--hz-bronze); background: var(--hz-cream); padding: 12px 12px 12px 18px; }
  #HzSub-{{ sid }} .hz-sub__code-val { font-family: var(--hz-head); font-weight: 600; font-size: 24px; letter-spacing: .22em; color: var(--hz-black); }
  #HzSub-{{ sid }} .hz-sub__copy { flex: none; min-height: 40px; padding: 0 16px; border: 0; background: #1F1F1F; color: #FFFFFF;
    font: inherit; font-size: 11px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; cursor: pointer; transition: background .3s ease; }
  #HzSub-{{ sid }} .hz-sub__copy:hover { background: var(--hz-bronze); }
  #HzSub-{{ sid }} .hz-sub__note { margin: 0; font-size: 12px; color: #85838F; }
  @media (max-width: 749px) {
    #HzSub-{{ sid }} .hz-sub__box { grid-template-columns: minmax(0,1fr); width: 420px; max-width: 100%; }
    #HzSub-{{ sid }} .hz-sub__media { min-height: 170px; }
    #HzSub-{{ sid }} .hz-sub__body { padding: 30px 22px 24px; }
    #HzSub-{{ sid }} .hz-sub__seal { width: 84px; height: 84px; }
    #HzSub-{{ sid }} .hz-sub__seal-lg { font-size: 26px; }
    #HzSub-{{ sid }} .hz-sub__title { font-size: 26px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #HzSub-{{ sid }} .hz-sub__dim, #HzSub-{{ sid }} .hz-sub__box { transition: none; animation: none !important; }
    #HzSub-{{ sid }} .hz-sub__step { transition: none; }
  }
</style>

<script>
  (function () {
    var all = document.querySelectorAll('[id="HzSub-{{ sid }}"]');
    var root = all[0];
    if (!root || root.dataset.ready) return;
    for (var i = 1; i < all.length; i++) if (all[i] !== root) all[i].remove();
    root.dataset.ready = '1';
    // Move the popup to <body> so theme section wrappers (transform / contain / content-visibility)
    // can't turn position:fixed into position:absolute. This stops it jumping and resizing.
    if (root.parentElement !== document.body) document.body.appendChild(root);
    document.addEventListener('shopify:section:unload', function (e) { if (e.detail && e.detail.sectionId === '{{ sid }}') root.remove(); });
    var KEY = 'hz-sub-popup', SUBS = 'hz-sub-done';
    var form = root.querySelector('form');
    var s1 = root.querySelector('[data-step="1"]'), s2 = root.querySelector('[data-step="2"]');
    var lastFocus = null;

    function open() {
      lastFocus = document.activeElement;
      var sb = window.innerWidth - document.documentElement.clientWidth;
      root.classList.remove('is-settled'); root.classList.add('is-open'); root.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('hz-sub-lock');
      if (sb > 0) document.body.style.paddingRight = sb + 'px';
      clearTimeout(root._st); root._st = setTimeout(function () { root.classList.add('is-settled'); }, 560);
      setTimeout(function () { var b = root.querySelector('.hz-sub__box'); if (b) b.focus({ preventScroll: true }); }, 350);
    }
    function close() {
      root.classList.remove('is-open', 'is-settled'); root.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('hz-sub-lock'); document.body.style.paddingRight = '';
      try { localStorage.setItem(KEY, String(Date.now())); } catch (e) {}
      if (lastFocus && lastFocus.focus) lastFocus.focus({ preventScroll: true });
    }
    function showCode() {
      if (!s2.hidden) return;
      s1.hidden = true; s2.hidden = false;
      try { localStorage.setItem(SUBS, '1'); } catch (e) {}
    }

    root.addEventListener('click', function (e) { if (e.target.closest('[data-hz-close]')) close(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && root.classList.contains('is-open')) close(); });

    var copyBtn = root.querySelector('[data-hz-copy]');
    if (copyBtn) copyBtn.addEventListener('click', function () {
      var code = root.querySelector('[data-hz-code]').textContent.trim();
      var done = function () { copyBtn.textContent = 'Copied ✓'; setTimeout(function () { copyBtn.textContent = 'Copy'; }, 1600); };
      if (navigator.clipboard) navigator.clipboard.writeText(code).then(done, done); else done();
    });

    var input = form.querySelector('.hz-sub__input'), err = form.querySelector('[data-hz-err]'), sending = false;
    var USED = 'hz-sub-emails';
    function usedList() { try { return JSON.parse(localStorage.getItem(USED) || '[]'); } catch (e) { return []; } }
    function remember(email) { try { var L = usedList(); if (L.indexOf(email) < 0) { L.push(email); localStorage.setItem(USED, JSON.stringify(L)); } localStorage.setItem(SUBS, '1'); } catch (e) {} }
    input.addEventListener('input', function () { err.hidden = true; });
    // Shopify protects customer forms with an invisible hCaptcha. Its script listens for the submit event,
    // adds <input name="h-captcha-response"> and then calls form.submit(). So the first submit is left to
    // Shopify's script, and we send by AJAX once the token is there.
    function hasToken() { var t = form.querySelector('[name="h-captcha-response"],[name="g-recaptcha-response"]'); return !!(t && t.value); }
    // Our own button must fire a real submit event so Shopify's CAPTCHA script can add its token.
    form.querySelector('[data-hz-submit]').addEventListener('click', function (e) { if (sending) { e.preventDefault(); } });
    function cleanEmail() { return (input.value || '').trim().toLowerCase(); }
    function emailOk() { return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(cleanEmail()); }
    function blocked() { return usedList().indexOf(cleanEmail()) > -1; }
    window.addEventListener('submit', function (e) {
      if (e.target !== form || form.dataset.native) return;
      if (!emailOk()) { e.preventDefault(); e.stopImmediatePropagation(); err.textContent = 'Please enter a valid email address.'; err.hidden = false; input.focus({ preventScroll: true }); return; }
      if (blocked()) { e.preventDefault(); e.stopImmediatePropagation(); err.textContent = 'This email is already subscribed. The 10% code is for new subscribers only.'; err.hidden = false; return; }
      if (hasToken()) { e.preventDefault(); e.stopImmediatePropagation(); send(); return; }
      err.hidden = true; form.querySelector('[data-hz-submit]').classList.add('is-busy');
      try { sessionStorage.setItem('hz-sub-pending', cleanEmail()); } catch (x) {}
    }, true);
    form.submit = function () { if (hasToken()) send(); else { form.dataset.native = '1'; HTMLFormElement.prototype.submit.call(form); } };
    function send() {
      if (sending || !s2.hidden) return;
      var email = cleanEmail();
      if (!emailOk()) { err.textContent = 'Please enter a valid email address.'; err.hidden = false; return; }
      if (blocked()) { err.textContent = 'This email is already subscribed. The 10% code is for new subscribers only.'; err.hidden = false; return; }
      err.hidden = true; sending = true;
      var fd = new FormData(form); fd.set('contact[email]', email);
      var btn = form.querySelector('[data-hz-submit]'); btn.classList.add('is-busy');
      function fail(msg) { sending = false; btn.classList.remove('is-busy'); err.textContent = msg; err.hidden = false; }
      function done() { sending = false; btn.classList.remove('is-busy'); remember(email); showCode(); }
      // A CAPTCHA token can only be used once. After a failed send, clear it so the next click gets a fresh one
      // (never re-post the form with the used token — that causes Shopify's "Invalid CAPTCHA token" page).
      function retry() { form.querySelectorAll('[name="h-captcha-response"],[name="g-recaptcha-response"]').forEach(function (t) { t.value = ''; }); fail('Please try again.'); }
      fetch(form.getAttribute('action') || '/contact', { method: 'POST', body: fd, credentials: 'same-origin', redirect: 'follow' })
        .then(function (r) {
          if (/\/challenge/.test(r.url)) { retry(); return; }
          if (/customer_posted=true/.test(r.url)) { done(); return; }
          if (!r.ok && r.status !== 422) { retry(); return; }
          return r.text().then(function (html) {
            var doc = new DOMParser().parseFromString(html, 'text/html');
            var f = doc.getElementById(form.id) || doc.querySelector('form[id^="HzSubForm-"]');
            if (f && f.querySelector('[data-hz-posted]')) { done(); return; }
            var errEl = f && f.querySelector('.hz-sub__err:not([data-hz-err])');
            var txt = ((errEl && errEl.textContent) || '').toLowerCase();
            if (/taken|already|exists|associated|subscribed/.test(txt)) { remember(email); fail('This email is already subscribed. The 10% code is for new subscribers only.'); return; }
            if (/invalid|format|blank/.test(txt)) { fail('Please enter a valid email address.'); return; }
            done();
          });
        })
        .catch(function () { retry(); });
    }

    var posted = !!root.querySelector('[data-hz-posted]') || /customer_posted=true/.test(location.search) || /customer_posted=true/.test(location.hash);
    var pending = ''; try { pending = sessionStorage.getItem('hz-sub-pending') || ''; sessionStorage.removeItem('hz-sub-pending'); } catch (e) {}
    if (posted && pending && usedList().indexOf(pending) > -1) { err.textContent = 'This email is already subscribed. The 10% code is for new subscribers only.'; err.hidden = false; open(); return; }
    if (posted) { if (pending) remember(pending); showCode(); open(); return; }

    if (root.dataset.design === 'true') { open(); return; }
    var mobile = window.matchMedia('(max-width: 749px)').matches;
    if (mobile && root.dataset.mobile !== 'true') return;
    try {
      if (localStorage.getItem(SUBS)) return;
      var last = +localStorage.getItem(KEY) || 0, days = +root.dataset.days || 7;
      if (last && Date.now() - last < days * 864e5) return;
    } catch (e) {}
    setTimeout(open, (+root.dataset.delay || 6) * 1000);
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Heitz subscribe popup",
  "class": "heitz-subscribe-popup",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show popup", "default": true },
    { "type": "range", "id": "delay", "label": "Open after (seconds)", "min": 1, "max": 30, "step": 1, "default": 6 },
    { "type": "range", "id": "days", "label": "Show again after closing (days)", "min": 1, "max": 30, "step": 1, "default": 7 },
    { "type": "checkbox", "id": "show_mobile", "label": "Show on mobile", "default": true },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "header", "content": "Gold seal" },
    { "type": "text", "id": "seal_top", "label": "Seal top", "default": "Get" },
