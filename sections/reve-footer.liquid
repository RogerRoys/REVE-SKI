{%- assign s = section.settings -%}
<footer class="rv rv-footer">
  <div class="rv-wrap rv-footer__top">
    <div class="rv-footer__brand">
      <span class="rv-footer__logo">{{ s.brand | default: shop.name | escape }}</span>
      {%- if s.about != blank -%}<div class="rv-footer__about">{{ s.about }}</div>{%- endif -%}
      <div class="rv-footer__social">
        {%- if s.instagram != blank -%}<a href="{{ s.instagram }}" aria-label="Instagram" target="_blank" rel="noopener">{% render 'reve-icon', icon: 'instagram' %}</a>{%- endif -%}
        {%- if s.xhs != blank -%}<a href="{{ s.xhs }}" aria-label="Xiaohongshu" target="_blank" rel="noopener">{%- if s.xhs_icon != blank -%}<img class="rv-footer__xhs" src="{{ s.xhs_icon | image_url: width: 64 }}" alt="" width="22" height="22" loading="lazy">{%- else -%}<span class="rv-footer__xhs-text">小红书</span>{%- endif -%}</a>{%- endif -%}
      </div>
    </div>
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'menu' -%}
          <nav class="rv-footer__col" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.heading | escape }}</h3>
            {%- for link in block.settings.menu.links -%}<a href="{{ link.url }}">{{ link.title | escape }}</a>{%- endfor -%}
          </nav>
        {%- when 'country' -%}
          <div class="rv-footer__col" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.heading | escape }}</h3>
            {%- if localization.available_countries.size > 1 -%}
              {%- form 'localization', class: 'rv-country' -%}
                {% render 'reve-icon', icon: 'globe' %}
                <select name="country_code" aria-label="Shipping country" data-rv-autosubmit>
                  {%- for c in localization.available_countries -%}
                    <option value="{{ c.iso_code }}"{% if c.iso_code == localization.country.iso_code %} selected{% endif %}>{{ c.name }} ({{ c.currency.iso_code }} {{ c.currency.symbol }})</option>
                  {%- endfor -%}
                </select>
                {% render 'reve-icon', icon: 'chevron' %}
              {%- endform -%}
            {%- else -%}
              <span class="rv-country">{% render 'reve-icon', icon: 'globe' %}<span class="rv-country__static">{{ localization.country.name }} ({{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }})</span></span>
            {%- endif -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
  <div class="rv-wrap rv-footer__bottom">
    <p class="rv-footer__copy">© {{ 'now' | date: '%Y' }} - {{ s.copyright | default: shop.name | escape }}</p>
    {%- if s.show_payments -%}
      <ul class="rv-footer__pay" aria-label="Payment methods">
        {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>
{% schema %}
{"name":"Reve · Footer","tag":"div","class":"rv-sec-footer","enabled_on":{"groups":["footer"]},
"settings":[
 {"type":"text","id":"brand","label":"Brand name","default":"Reve Ski"},
 {"type":"richtext","id":"about","label":"About text","default":"<p>Merging urban elegance with alpine functionality. Founded in 2023, we're redefining women's ski wear for the modern adventurer.</p>"},
 {"type":"url","id":"instagram","label":"Instagram link"},
 {"type":"url","id":"xhs","label":"Xiaohongshu link"},
 {"type":"image_picker","id":"xhs_icon","label":"Xiaohongshu icon"},
 {"type":"text","id":"copyright","label":"Copyright text","default":"Reve Ski | Urban Elegance , Alpine Excellence"},
 {"type":"checkbox","id":"show_payments","label":"Show payment icons","default":true}
],
"blocks":[
 {"type":"menu","name":"Menu","settings":[{"type":"text","id":"heading","label":"Heading","default":"Shop"},{"type":"link_list","id":"menu","label":"Menu","default":"footer"}]},
 {"type":"country","name":"Shipping to","limit":1,"settings":[{"type":"text","id":"heading","label":"Heading","default":"Shipping To"}]}
],
"presets":[{"name":"Reve · Footer","blocks":[{"type":"menu"},{"type":"menu","settings":{"heading":"Help"}},{"type":"country"}]}]}
{% endschema %}