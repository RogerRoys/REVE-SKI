{%- render 'reve-section-style' -%}
{%- assign s = section.settings -%}
<section class="rv rv-hero" {% if s.transparent_header %}allow-transparent-header{% endif %} style="--rv-hero-pos:{{ s.focal | default: '50% 50%' }}">
  <div class="rv-hero__media">
    {%- if s.video != blank -%}
      {{ s.video | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, controls: false, image_size: '1920x' }}
    {%- elsif s.image != blank -%}
      <img src="{{ s.image | image_url: width: 1920 }}" srcset="{{ s.image | image_url: width: 750 }} 750w, {{ s.image | image_url: width: 1100 }} 1100w, {{ s.image | image_url: width: 1500 }} 1500w, {{ s.image | image_url: width: 1920 }} 1920w, {{ s.image | image_url: width: 2400 }} 2400w" sizes="100vw" width="{{ s.image.width }}" height="{{ s.image.height }}" alt="{{ s.image.alt | escape }}" fetchpriority="high">
    {%- elsif s.image_asset != blank -%}
      <img src="{{ s.image_asset | asset_url }}" sizes="100vw" width="1920" height="1280" alt="{{ s.heading | escape }}" fetchpriority="high">
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'rv-placeholder' }}
    {%- endif -%}
  </div>
  <div class="rv-hero__shade"></div>
  <div class="rv-hero__content">
    <div class="rv-wrap rv-hero__stack">
      <div class="rv-hero__row">
        {%- if s.text != blank -%}<div class="rv-hero__text">{{ s.text }}</div>{%- endif -%}
        {%- if s.button_label != blank -%}<a href="{{ s.button_link | default: routes.all_products_collection_url }}" class="rv-btn rv-btn--light">{{ s.button_label | escape }}</a>{%- endif -%}
      </div>
      {%- if s.heading != blank -%}<h1 class="rv-hero__title">{{ s.heading | escape }}</h1>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
 "name": "Reve · Hero",
 "tag": "div",
 "class": "rv-sec-hero",
 "settings": [
  {
   "type": "checkbox",
   "id": "transparent_header",
   "label": "Transparent header over this hero",
   "default": true
  },
  {
   "type": "image_picker",
   "id": "image",
   "label": "Image"
  },
  {
   "type": "text",
   "id": "image_asset",
   "label": "Fallback image file (assets)",
   "info": "File name in the theme assets folder, used only when no image is picked above"
  },
  {
   "type": "video",
   "id": "video",
   "label": "Video (optional, replaces image)"
  },
  {
   "type": "text",
   "id": "focal",
   "label": "Image position",
   "default": "50% 45%",
   "info": "e.g. 50% 30% (horizontal vertical)"
  },
  {
   "type": "text",
   "id": "heading",
   "label": "Heading",
   "default": "The Western Edit"
  },
  {
   "type": "richtext",
   "id": "text",
   "label": "Text",
   "default": "<p>This season, we’re taking fringe to the mountains.</p>"
  },
  {
   "type": "text",
   "id": "button_label",
   "label": "Button label",
   "default": "Shop Now"
  },
  {
   "type": "url",
   "id": "button_link",
   "label": "Button link"
  },
  {
   "type": "header",
   "content": "Text & colors"
  },
  {
   "type": "paragraph",
   "content": "0 or empty = use the design default."
  },
  {
   "type": "range",
   "id": "rv_heading_size",
   "label": "Heading size (desktop)",
   "min": 0,
   "max": 200,
   "step": 2,
   "unit": "px",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_heading_size_mobile",
   "label": "Heading size (mobile)",
   "min": 0,
   "max": 120,
   "step": 2,
   "unit": "px",
   "default": 0
  },
  {
   "type": "select",
   "id": "rv_heading_uppercase",
   "label": "Heading case",
   "options": [
    {
     "value": "default",
     "label": "Design default"
    },
    {
     "value": "on",
     "label": "Uppercase"
    },
    {
     "value": "off",
     "label": "As typed"
    }
   ],
   "default": "default"
  },
  {
   "type": "range",
   "id": "rv_letter_spacing",
   "label": "Heading letter spacing",
   "min": -5,
   "max": 30,
   "step": 1,
   "unit": "%",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_text_size",
   "label": "Text size (desktop)",
   "min": 0,
   "max": 32,
   "step": 1,
   "unit": "px",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_text_size_mobile",
   "label": "Text size (mobile)",
   "min": 0,
   "max": 28,
   "step": 1,
   "unit": "px",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_small_size",
   "label": "Small text / labels size",
   "min": 0,
   "max": 20,
   "step": 1,
   "unit": "px",
   "default": 0
  },
  {
   "type": "color",
   "id": "rv_text_color",
   "label": "Text color"
  },
  {
   "type": "color",
   "id": "rv_bg_color",
   "label": "Background color"
  },
  {
   "type": "color",
   "id": "rv_accent_color",
   "label": "Accent color (links, lines, buttons)"
  }
 ],
 "presets": [
  {
   "name": "Reve · Hero"
  }
 ]
}
{% endschema %}