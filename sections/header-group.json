{
  "type": "header",
  "name": "Header group",
  "sections": {
    "announcement-bar": {
      "type": "announcement-bar",
      "blocks": {
        "message_new_season": {
          "type": "message",
          "settings": {
            "text": "The new season starts here. <a href=\"/collections/new-arrivals\">Shop new arrivals</a>"
          }
        },
        "message_shipping": {
          "type": "message",
          "settings": {
            "text": "Free FedEx® delivery on orders over $800"
          }
        },
        "message_returns": {
          "type": "message",
          "settings": {
            "text": "Free & easy returns within 14 days of delivery"
          }
        }
      },
      "block_order": [
        "message_new_season",
        "message_shipping",
        "message_returns"
      ],
      "settings": {
        "enable_sticky": false,
        "autoplay": true,
        "cycle_speed": 5,
        "desktop_font_size": 11,
        "mobile_font_size": 10,
        "background": "#000000",
        "text_color": "#ffffff",
        "show_dots": true,
        "show_pause_button": true,
        "text_font": "body",
        "uppercase": false,
        "letter_spacing": 1,
        "vertical_padding": 9,
        "dot_size": 4,
        "controls_color": "#ffffff"
      }
    },
    "header": {
      "type": "header",
      "settings": {
        "enable_sticky": true,
        "show_separation_border": false,
        "reduce_padding": true,
        "logo_max_width": 110,
        "logo_mobile_max_width": 80,
        "menu": "main-menu",
        "sidebar_menu": "",
        "menu_open_trigger": "hover",
        "enable_search": true,
        "sidebar_text_font": "body",
        "sidebar_show_dividers": false,
        "layout": "logo_center_navigation_inline",
        "show_icons": true,
        "show_country_selector": false,
        "show_country_name": false,
        "show_country_flag": false,
        "show_locale_selector": false,
        "transparent_header_text_color": "#ffffff",
        "nav_font": "body",
        "nav_uppercase": true,
        "nav_font_size": 20,
        "nav_letter_spacing": 4,
        "nav_gap": 56,
        "use_custom_links": true,
        "link_1_text": "Shop",
        "link_1_url": "shopify://collections/all",
        "link_2_text": "About",
        "link_2_url": "shopify://pages/about-us",
        "show_utility_nav": false,
        "nav_font_weight": "400"
      }
    }
  },
  "order": [
    "announcement-bar",
    "header"
  ]
