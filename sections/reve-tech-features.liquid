{%- assign s = section.settings -%}
{%- if section.blocks.size > 0 -%}
<section class="rv rv-tech">
  <div class="rv-wrap rv-tech__inner">
    <div class="rv-tech__intro">
      <h2 class="rv-h-xl">{{ s.heading | escape }}</h2>
      {%- if s.text != blank -%}<p>{{ s.text | escape }}</p>{%- endif -%}
    </div>
    <div class="rv-tech__grid">
      <div class="rv-tech__media">
        {%- assign timg = s.image | default: product.media.last -%}
        {%- if timg -%}
          <img src="{{ timg | image_url: width: 1400 }}" srcset="{{ timg | image_url: width: 700 }} 700w, {{ timg | image_url: width: 1000 }} 1000w, {{ timg | image_url: width: 1400 }} 1400w" sizes="(min-width: 990px) 50vw, 100vw" alt="" loading="lazy">
        {%- else -%}
          {{ 'detailed-apparel-1' | placeholder_svg_tag: 'rv-placeholder' }}
        {%- endif -%}
      </div>
      <dl class="rv-tech__list">
        {%- for block in section.blocks -%}
          <div class="rv-tech__row" {{ block.shopify_attributes }}><dt>{{ block.settings.name | escape }}</dt><dd>{{ block.settings.text | escape }}</dd></div>
        {%- endfor -%}
      </dl>
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{"name":"Reve · Technical features","tag":"div","class":"rv-sec-tech",
"settings":[
 {"type":"text","id":"heading","label":"Heading","default":"Technical Features"},
 {"type":"textarea","id":"text","label":"Intro","default":"Advanced materials and responsible design come together to deliver uncompromising performance and lasting comfort."},
 {"type":"image_picker","id":"image","label":"Image","info":"Leave empty to use the product's last image"}
],
"blocks":[{"type":"feature","name":"Feature","settings":[{"type":"text","id":"name","label":"Name","default":"Waterproof Softshell"},{"type":"text","id":"text","label":"Description","default":"10,000 mm H₂O waterproof rating"}]}],
"presets":[{"name":"Reve · Technical features","blocks":[{"type":"feature"}]}]}
{% endschema %}