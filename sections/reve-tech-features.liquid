{%- render 'reve-section-style' -%}
{%- assign s = section.settings -%}
{%- if section.blocks.size > 0 -%}
<section class="rv rv-tech">
  <div class="rv-wrap rv-tech__inner">
    <div class="rv-tech__intro">
      <h2 class="rv-h-xl">{{ s.heading | escape }}</h2>
      {%- if s.text != blank -%}<p>{{ s.text | escape }}</p>{%- endif -%}
    </div>
    <div class="rv-tech__grid">
      <div class="rv-tech__media">
        {%- assign timg = s.image | default: product.media.last -%}
        {%- if timg -%}
          <img src="{{ timg | image_url: width: 1400 }}" srcset="{{ timg | image_url: width: 700 }} 700w, {{ timg | image_url: width: 1000 }} 1000w, {{ timg | image_url: width: 1400 }} 1400w" sizes="(min-width: 990px) 50vw, 100vw" alt="" loading="lazy">
        {%- else -%}
          {{ 'detailed-apparel-1' | placeholder_svg_tag: 'rv-placeholder' }}
        {%- endif -%}
      </div>
      <dl class="rv-tech__list">
        {%- for block in section.blocks -%}
          <div class="rv-tech__row" {{ block.shopify_attributes }}><dt>{{ block.settings.name | escape }}</dt><dd>{{ block.settings.text | escape }}</dd></div>
        {%- endfor -%}
      </dl>
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
 "name": "Reve · Technical features",
 "tag": "div",
 "class": "rv-sec-tech",
 "settings": [
  {
   "type": "text",
   "id": "heading",
   "label": "Heading",
   "default": "Technical Features"
  },
  {
   "type": "textarea",
   "id": "text",
   "label": "Intro",
   "default": "Advanced materials and responsible design come together to deliver uncompromising performance and lasting comfort."
  },
  {
   "type": "image_picker",
   "id": "image",
   "label": "Image",
   "info": "Leave empty to use the product's last image"
  },
  {
   "type": "header",
   "content": "Text & colors"
  },
  {
   "type": "paragraph",
   "content": "0 or empty = use the design default."
  },
  {
   "type": "range",
   "id": "rv_heading_size",
   "label": "Heading size (desktop)",
   "min": 0,
   "max": 200,
   "step": 2,
   "unit": "px",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_heading_size_mobile",
   "label": "Heading size (mobile)",
   "min": 0,
   "max": 120,
   "step": 2,
   "unit": "px",
   "default": 0
  },
  {
   "type": "select",
   "id": "rv_heading_uppercase",
   "label": "Heading case",
   "options": [
    {
     "value": "default",
     "label": "Design default"
    },
    {
     "value": "on",
     "label": "Uppercase"
    },
    {
     "value": "off",
     "label": "As typed"
    }
   ],
   "default": "default"
  },
  {
   "type": "range",
   "id": "rv_letter_spacing",
   "label": "Heading letter spacing",
   "min": -5,
   "max": 30,
   "step": 1,
   "unit": "%",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_text_size",
   "label": "Text size (desktop)",
   "min": 0,
   "max": 32,
   "step": 1,
   "unit": "px",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_text_size_mobile",
   "label": "Text size (mobile)",
   "min": 0,
   "max": 28,
   "step": 1,
   "unit": "px",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_small_size",
   "label": "Small text / labels size",
   "min": 0,
   "max": 20,
   "step": 1,
   "unit": "px",
   "default": 0
  },
  {
   "type": "color",
   "id": "rv_text_color",
   "label": "Text color"
  },
  {
   "type": "color",
   "id": "rv_bg_color",
   "label": "Background color"
  },
  {
   "type": "color",
   "id": "rv_accent_color",
   "label": "Accent color (links, lines, buttons)"
  }
 ],
 "blocks": [
  {
   "type": "feature",
   "name": "Feature",
   "settings": [
    {
     "type": "text",
     "id": "name",
     "label": "Name",
     "default": "Waterproof Softshell"
    },
    {
     "type": "text",
     "id": "text",
     "label": "Description",
     "default": "10,000 mm H₂O waterproof rating"
    }
   ]
  }
 ],
 "presets": [
  {
   "name": "Reve · Technical features",
   "blocks": [
    {
     "type": "feature"
    }
   ]
  }
 ]
}
{% endschema %}