{%- render 'reve-section-style' -%}
<div class="rv rv-wrap rv-services">
  {%- for block in section.blocks -%}
    <div class="rv-service" {{ block.shopify_attributes }}>
      {%- if section.settings.numbers -%}<span class="rv-service__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>{%- endif -%}
      <span class="rv-service__title">{{ block.settings.title | escape }}</span>
      {%- if block.settings.text != blank -%}<p class="rv-service__text">{{ block.settings.text | escape }}</p>{%- endif -%}
      {%- if block.settings.link_label != blank -%}<a href="{{ block.settings.link | default: '#' }}" class="rv-link">{{ block.settings.link_label | escape }}</a>{%- endif -%}
    </div>
  {%- endfor -%}
</div>
{% schema %}
{
 "name": "Reve · Services",
 "tag": "section",
 "class": "rv-sec-services",
 "max_blocks": 4,
 "settings": [
  {
   "type": "checkbox",
   "id": "numbers",
   "label": "Show numbers",
   "default": true
  },
  {
   "type": "header",
   "content": "Text & colors"
  },
  {
   "type": "paragraph",
   "content": "0 or empty = use the design default."
  },
  {
   "type": "range",
   "id": "rv_heading_size",
   "label": "Heading size (desktop)",
   "min": 0,
   "max": 200,
   "step": 2,
   "unit": "px",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_heading_size_mobile",
   "label": "Heading size (mobile)",
   "min": 0,
   "max": 120,
   "step": 2,
   "unit": "px",
   "default": 0
  },
  {
   "type": "select",
   "id": "rv_heading_uppercase",
   "label": "Heading case",
   "options": [
    {
     "value": "default",
     "label": "Design default"
    },
    {
     "value": "on",
     "label": "Uppercase"
    },
    {
     "value": "off",
     "label": "As typed"
    }
   ],
   "default": "default"
  },
  {
   "type": "range",
   "id": "rv_letter_spacing",
   "label": "Heading letter spacing",
   "min": -5,
   "max": 30,
   "step": 1,
   "unit": "%",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_text_size",
   "label": "Text size (desktop)",
   "min": 0,
   "max": 32,
   "step": 1,
   "unit": "px",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_text_size_mobile",
   "label": "Text size (mobile)",
   "min": 0,
   "max": 28,
   "step": 1,
   "unit": "px",
   "default": 0
  },
  {
   "type": "range",
   "id": "rv_small_size",
   "label": "Small text / labels size",
   "min": 0,
   "max": 20,
   "step": 1,
   "unit": "px",
   "default": 0
  },
  {
   "type": "color",
   "id": "rv_text_color",
   "label": "Text color"
  },
  {
   "type": "color",
   "id": "rv_bg_color",
   "label": "Background color"
  },
  {
   "type": "color",
   "id": "rv_accent_color",
   "label": "Accent color (links, lines, buttons)"
  }
 ],
 "blocks": [
  {
   "type": "service",
   "name": "Service",
   "settings": [
    {
     "type": "text",
     "id": "title",
     "label": "Title",
     "default": "Get Help Buying"
    },
    {
     "type": "textarea",
     "id": "text",
     "label": "Text",
     "default": "If you have any questions about our gear, get in touch."
    },
    {
     "type": "text",
     "id": "link_label",
     "label": "Link label",
     "default": "Learn more"
    },
    {
     "type": "url",
     "id": "link",
     "label": "Link"
    }
   ]
  }
 ],
 "presets": [
  {
   "name": "Reve · Services",
   "blocks": [
    {
     "type": "service"
    },
    {
     "type": "service"
    },
    {
     "type": "service"
    }
   ]
  }
 ]
}
{% endschema %}